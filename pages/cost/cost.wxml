<view class="container">
  <view class="date-bar">
    <text class="date-label">摆摊日期</text>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="date-value">{{date}} ›</view>
    </picker>
  </view>

  <!-- ① 每日变动成本（可自定义多条） -->
  <view class="card">
    <view class="card-title">① 每日变动成本</view>
    <view class="var-item" wx:for="{{variableItems}}" wx:key="id">
      <input class="var-name" value="{{item.name}}" data-id="{{item.id}}" bindinput="onVarName" placeholder="项目名称"/>
      <input class="var-amount" type="digit" value="{{item.amount}}" data-id="{{item.id}}" bindinput="onVarAmount" placeholder="0"/>
      <text class="var-del" data-id="{{item.id}}" bindtap="delVar">删除</text>
    </view>
    <button class="btn-add" bindtap="addVar">+ 新增成本项</button>
    <view class="summary-row">
      <text>当日变动成本合计</text>
      <text class="summary-num">¥{{variableCost}}</text>
    </view>
    <button class="btn-primary" bindtap="saveVariable">保存变动成本</button>
  </view>

  <!-- ② 一次性大宗采购 -->
  <view class="card">
    <view class="card-title">② 一次性大宗采购</view>
    <view class="field">
      <text class="field-label">物料名称</text>
      <input class="field-input" value="{{bulkName}}" bindinput="onBulkName" placeholder="如：打包碗"/>
    </view>
    <view class="field">
      <text class="field-label">总花费（元）</text>
      <input class="field-input" type="digit" value="{{bulkCost}}" bindinput="onBulkCost" placeholder="0"/>
    </view>
    <view class="field">
      <text class="field-label">预计摆摊天数</text>
      <input class="field-input" type="number" value="{{bulkDays}}" bindinput="onBulkDays" placeholder="如：30"/>
    </view>
    <button class="btn-primary" bindtap="addBulk">添加大宗采购</button>

    <view class="bulk-list" wx:if="{{bulkList.length > 0}}">
      <view class="bulk-item" wx:for="{{bulkList}}" wx:key="id">
        <view class="bulk-info">
          <text class="bulk-name">{{item.name}}</text>
          <text class="bulk-detail">¥{{item.totalCost}} / {{item.days}}天 ≈ ¥{{item.daily}}/天</text>
        </view>
        <text class="bulk-del" data-id="{{item.id}}" bindtap="delBulk">删除</text>
      </view>
    </view>

    <view class="summary-row" wx:if="{{bulkList.length > 0}}">
      <text>大宗物料每日分摊</text>
      <text class="summary-num">¥{{bulkDaily}}</text>
    </view>
  </view>

  <!-- ③ 每日固定成本 -->
  <view class="card">
    <view class="card-title">③ 每日固定成本</view>
    <view class="field">
      <text class="field-label">摊位费（元/天）</text>
      <input class="field-input" type="digit" value="{{stallFee}}" bindinput="onStallInput" placeholder="0"/>
    </view>
    <button class="btn-primary" bindtap="saveStall">保存摊位费</button>
  </view>

  <!-- 当日总成本（预估） -->
  <view class="card">
    <view class="card-title">当日总成本（预估）</view>
    <view class="summary-row"><text>变动成本</text><text>¥{{variableCost}}</text></view>
    <view class="summary-row"><text>大宗分摊</text><text>¥{{bulkDaily}}</text></view>
    <view class="summary-row"><text>摊位费</text><text>¥{{stallFee || '0'}}</text></view>
    <view class="summary-row total"><text>合计</text><text class="summary-num">¥{{estimatedTotal}}</text></view>
  </view>
</view>
