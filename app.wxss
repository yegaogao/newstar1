/* ============================================================
   福鼎肉片地摊记账 · 全局样式
   设计：简约专业账本风（暖橙主色 + 中性灰底 + 白卡片）
   仅调整布局/间距/配色，未改动任何记账计算逻辑
   ============================================================ */

page {
  background: #F3F4F6;
  font-size: 30rpx;
  color: #374151;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}
view, text, input, button, picker { box-sizing: border-box; }

.container {
  padding: 24rpx 24rpx 90rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border: 1rpx solid #ECEEF1;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 14rpx rgba(17, 24, 39, 0.05);
}
/* 卡片标题：左侧主色竖条，账本分区感 */
.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 24rpx;
  padding-left: 22rpx;
  border-left: 8rpx solid #F26419;
  line-height: 1.3;
}
.card-sub {
  font-size: 30rpx;
  color: #6B7280;
  margin: 28rpx 0 12rpx;
}

/* ---------- 日期栏 ---------- */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid #ECEEF1;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 14rpx rgba(17, 24, 39, 0.05);
}
.date-label { font-size: 30rpx; color: #6B7280; }
.date-value { font-size: 38rpx; font-weight: 700; color: #F26419; }

/* ---------- 字段（标签 + 输入框） ---------- */
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F1F3;
}
.field:last-of-type { border-bottom: none; }
.field-label { font-size: 32rpx; color: #4B5563; }
.field-input {
  text-align: right;
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  width: 320rpx;
  background: #F7F8FA;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  width: 100%;
  margin-top: 28rpx;
  background: #F26419;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 22rpx 0;
  line-height: 1.5;
  box-shadow: 0 6rpx 16rpx rgba(242, 100, 25, 0.22);
}
.btn-primary:active { background: #D9530F; }
.btn-primary::after { border: none; }

.btn-danger {
  width: 100%;
  background: #fff;
  color: #EF4444;
  border: 2rpx solid #FCA5A5;
  font-size: 30rpx;
  border-radius: 16rpx;
  padding: 18rpx 0;
}
.btn-danger:active { background: #FEF2F2; }
.btn-danger::after { border: none; }

/* 添加类按钮（虚线描边，弱提示） */
.btn-add {
  width: 100%;
  margin-top: 22rpx;
  background: #FFF7F2;
  color: #E8590C;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 20rpx 0;
  border: 1rpx dashed #F3B79A;
}
.btn-add:active { background: #FDEFE6; }
.btn-add::after { border: none; }

/* 快捷加份按钮 */
.quick-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 20rpx;
}
.quick-btn {
  padding: 14rpx 36rpx;
  background: #FFF0E8;
  color: #F26419;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
}
.quick-btn:active { background: #FBDCC8; }

/* ---------- 步进器（份数加减） ---------- */
.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 12rpx;
}
.step-btn {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 60rpx;
  font-weight: 700;
  color: #F26419;
  background: #FFF0E8;
  border-radius: 20rpx;
}
.step-btn:active { background: #FBDCC8; }
.step-num {
  min-width: 180rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 800;
  color: #111827;
  margin: 0 30rpx;
}

/* ---------- 汇总行 ---------- */
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #4B5563;
}
.summary-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #F26419;
}
.summary-row.total {
  border-top: 1rpx solid #ECEEF1;
  margin-top: 12rpx;
  padding-top: 28rpx;
  font-weight: 700;
  color: #1F2937;
}
.big-num {
  font-size: 56rpx;
  font-weight: 800;
}
.red { color: #E53935; }    /* 盈利 - 红（中文习惯） */
.green { color: #2E7D32; } /* 亏损 - 绿 */

/* ---------- 一次性大宗采购列表 ---------- */
.bulk-list {
  margin-top: 28rpx;
  border-top: 1rpx solid #F0F1F3;
}
.bulk-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F1F3;
}
.bulk-info { display: flex; flex-direction: column; }
.bulk-name { font-size: 32rpx; font-weight: 600; color: #1F2937; }
.bulk-detail { font-size: 26rpx; color: #9CA3AF; margin-top: 8rpx; }
.bulk-del {
  font-size: 28rpx;
  color: #EF4444;
  padding: 10rpx 20rpx;
  background: #FEF2F2;
  border-radius: 10rpx;
}
.bulk-del:active { background: #FCE0E0; }

/* ---------- 每日变动成本：可自定义多条 ---------- */
.var-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F1F3;
  gap: 16rpx;
}
.var-name {
  flex: 1;
  font-size: 32rpx;
  color: #111827;
  background: #F7F8FA;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
}
.var-amount {
  width: 200rpx;
  text-align: right;
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  background: #F7F8FA;
  border: 1rpx solid #E5E7EB;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
}
.var-del {
  font-size: 28rpx;
  color: #EF4444;
  padding: 12rpx 16rpx;
  background: #FEF2F2;
  border-radius: 10rpx;
}
.var-del:active { background: #FCE0E0; }

/* ---------- 售卖页：商品选择 / 新增 ---------- */
.picker-value {
  text-align: right;
  font-size: 38rpx;
  font-weight: 700;
  color: #F26419;
}
.add-prod {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F3;
}
.add-input {
  flex: 1;
  background: #F7F8FA;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  color: #111827;
}
.add-input.price { flex: 0 0 200rpx; }
.add-btn {
  background: #F26419;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 18rpx 34rpx;
  border-radius: 12rpx;
}
.add-btn:active { background: #D9530F; }
.tip {
  text-align: center;
  color: #9CA3AF;
  font-size: 28rpx;
  margin: 24rpx 20rpx;
}

/* ---------- 历史记录 ---------- */
.page-head {
  font-size: 42rpx;
  font-weight: 800;
  color: #1F2937;
  padding: 8rpx 8rpx 24rpx;
}
.empty {
  text-align: center;
  color: #9CA3AF;
  font-size: 30rpx;
  padding: 120rpx 40rpx;
}
.record {
  background: #fff;
  border: 1rpx solid #ECEEF1;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 14rpx rgba(17, 24, 39, 0.05);
  overflow: hidden;
}
.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  background: #FAFBFC;
}
.record-date { font-size: 36rpx; font-weight: 700; color: #1F2937; }
.record-profit { font-size: 34rpx; font-weight: 700; }
.record-body {
  padding: 8rpx 32rpx 28rpx;
  border-top: 1rpx solid #F0F1F3;
}
/* 账本明细行 */
.line {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: #6B7280;
  border-bottom: 1rpx solid #F5F6F8;
}
.line.strong {
  font-weight: 700;
  color: #1F2937;
  font-size: 32rpx;
  padding: 20rpx 0;
  border-bottom: none;
}
.divider {
  height: 1rpx;
  background: #ECEEF1;
  margin: 12rpx 0;
}
.clear-wrap { margin-top: 24rpx; padding: 10rpx; }

/* 历史页：商品销售明细行 */
.prod-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #4B5563;
  border-bottom: 1rpx solid #F5F6F8;
}
.prod-name { color: #1F2937; font-weight: 600; }
.prod-sub { color: #9CA3AF; font-size: 26rpx; margin-left: 14rpx; font-weight: 400; }
.prod-empty { font-size: 28rpx; color: #C0C4CC; padding: 12rpx 0 4rpx; }
