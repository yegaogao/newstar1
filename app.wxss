page {
  background: #fff7f0;
  font-size: 34rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #d84315;
  margin-bottom: 16rpx;
}
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}
.field-label {
  font-size: 34rpx;
  color: #444;
}
.field-input {
  text-align: right;
  font-size: 42rpx;
  font-weight: 600;
  color: #222;
  width: 320rpx;
}
.btn-primary {
  margin-top: 28rpx;
  background: #d84315;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 18rpx 0;
  line-height: 1.6;
}
.btn-primary::after { border: none; }
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 34rpx;
  color: #555;
}
.summary-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #d84315;
}
.summary-row.total {
  border-top: 2rpx solid #eee;
  margin-top: 10rpx;
  padding-top: 26rpx;
  font-weight: 700;
  color: #333;
}
.big-num {
  font-size: 56rpx;
  font-weight: 800;
}
.red { color: #e53935; }
.green { color: #2e7d32; }
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.date-label { font-size: 34rpx; color: #666; }
.date-value { font-size: 40rpx; font-weight: 700; color: #d84315; }

/* stepper（份数加减） */
.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0 10rpx;
}
.step-btn {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #d84315;
  background: #fff3e0;
  border-radius: 20rpx;
}
.step-num {
  min-width: 160rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 800;
  color: #222;
  margin: 0 30rpx;
}
.quick-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
}
.quick-btn {
  padding: 14rpx 36rpx;
  background: #ffe0cc;
  color: #d84315;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

/* 大宗采购列表 */
.bulk-list {
  margin-top: 24rpx;
  border-top: 2rpx solid #f2f2f2;
}
.bulk-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}
.bulk-info { display: flex; flex-direction: column; }
.bulk-name { font-size: 34rpx; font-weight: 600; color: #333; }
.bulk-detail { font-size: 28rpx; color: #999; margin-top: 6rpx; }
.bulk-del { font-size: 30rpx; color: #e53935; padding: 10rpx 20rpx; }

/* 历史记录 */
.page-head {
  font-size: 44rpx;
  font-weight: 800;
  color: #d84315;
  padding: 10rpx 8rpx 28rpx;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 32rpx;
  padding: 120rpx 40rpx;
}
.record {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  overflow: hidden;
}
.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}
.record-date { font-size: 38rpx; font-weight: 700; color: #333; }
.record-profit { font-size: 36rpx; font-weight: 700; }
.record-body {
  padding: 0 32rpx 28rpx;
  border-top: 2rpx solid #f3f3f3;
}
.line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 32rpx;
  color: #666;
}
.line.strong {
  font-weight: 700;
  color: #333;
  font-size: 34rpx;
  padding: 18rpx 0;
}
.divider {
  height: 2rpx;
  background: #eee;
  margin: 8rpx 0;
}
.clear-wrap { margin-top: 20rpx; padding: 10rpx; }
.btn-danger {
  background: #fff;
  color: #e53935;
  border: 2rpx solid #e53935;
  font-size: 32rpx;
  border-radius: 16rpx;
  padding: 16rpx 0;
}
.btn-danger::after { border: none; }
.del-prod-btn { margin-top: 20rpx; width: 100%; }

/* 每日变动成本：可自定义多条 */
.var-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
  gap: 16rpx;
}
.var-name {
  flex: 1;
  font-size: 34rpx;
  color: #333;
}
.var-amount {
  width: 170rpx;
  text-align: right;
  font-size: 42rpx;
  font-weight: 600;
  color: #222;
}
.var-del {
  font-size: 28rpx;
  color: #e53935;
  padding: 8rpx 14rpx;
}
.btn-add {
  margin-top: 22rpx;
  background: #fff3e0;
  color: #d84315;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 16rpx 0;
}
.btn-add::after { border: none; }

/* 商品选择区域（售卖页） */
.picker-value {
  text-align: right;
  font-size: 40rpx;
  font-weight: 700;
  color: #d84315;
}
.add-prod {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f2f2f2;
}
.add-input {
  flex: 1;
  background: #fff3e0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 32rpx;
  color: #333;
}
.add-input.price { flex: 0 0 200rpx; }
.add-btn {
  background: #d84315;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 18rpx 32rpx;
  border-radius: 12rpx;
}
.card-sub {
  font-size: 34rpx;
  color: #444;
  margin: 24rpx 0 8rpx;
}
.tip {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin: 24rpx 20rpx;
}

/* 历史页：商品销售明细 */
.prod-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 32rpx;
  color: #555;
}
.prod-name { color: #333; font-weight: 600; }
.prod-sub { color: #999; font-size: 28rpx; margin-left: 14rpx; font-weight: 400; }
.prod-empty { font-size: 30rpx; color: #bbb; padding: 12rpx 0 4rpx; }
